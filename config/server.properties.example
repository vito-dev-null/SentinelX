server.port=5050
node.id=nodo1
desktop.appName=SentinelX 3 — Security Operations Center — Node 1
database.path=data/siem.db
database.busyTimeoutMs=5000
database.walEnabled=true
server.maxEventsPerSecond=5000
server.maxEventSizeBytes=65536
server.maxConnections=100
server.queueCapacity=10000
soc.enabled=true
soc.port=8080
tls.enabled=false
tls.requireClientAuth=false
tls.keystore.path=config/certs/server.p12
tls.keystore.password=${SENTINELX_TLS_KEYSTORE_PASSWORD}
tls.truststore.path=config/certs/truststore.p12
tls.truststore.password=${SENTINELX_TLS_TRUSTSTORE_PASSWORD}
soar.dryRun=true
network.enabled=true
network.interface=auto
network.captureMode=INTERFACE
network.flowTimeoutSeconds=60
network.retentionDays=30
network.metricsIntervalSeconds=1
